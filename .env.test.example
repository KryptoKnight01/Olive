OLIVE_APP_ENV=testing
OLIVE_LOG_LEVEL=WARNING
OLIVE_DATABASE_URL=postgresql+asyncpg://olive:olive@localhost:5433/olive_test
OLIVE_REDIS_URL=redis://localhost:6380/0
OLIVE_DEPENDENCY_TIMEOUT_SECONDS=1.0
OLIVE_SIGNAL_HMAC_KEY_ID=tradingview-test
OLIVE_SIGNAL_HMAC_SECRET=test-only-secret
OLIVE_SIGNAL_MAX_AGE_SECONDS=300
OLIVE_SIGNAL_NONCE_TTL_SECONDS=900
OLIVE_SIGNAL_RATE_LIMIT=100
OLIVE_SIGNAL_RATE_WINDOW_SECONDS=60
OLIVE_SIGNAL_MAX_PAYLOAD_BYTES=65536
