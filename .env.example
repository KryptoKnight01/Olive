OLIVE_APP_ENV=development
OLIVE_APP_NAME=Olive Trading Platform
OLIVE_APP_VERSION=0.1.0
OLIVE_LOG_LEVEL=INFO
OLIVE_DATABASE_URL=postgresql+asyncpg://olive:olive@localhost:5432/olive
OLIVE_REDIS_URL=redis://localhost:6379/0
OLIVE_DEPENDENCY_TIMEOUT_SECONDS=2.0
OLIVE_SIGNAL_HMAC_KEY_ID=tradingview-development
OLIVE_SIGNAL_HMAC_SECRET=
OLIVE_SIGNAL_MAX_AGE_SECONDS=300
OLIVE_SIGNAL_NONCE_TTL_SECONDS=900
OLIVE_SIGNAL_RATE_LIMIT=60
OLIVE_SIGNAL_RATE_WINDOW_SECONDS=60
OLIVE_SIGNAL_MAX_PAYLOAD_BYTES=65536
