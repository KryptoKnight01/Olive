# Copy this file to .env.staging and replace every CHANGE_ME value.
# Never commit .env.staging or real credentials.
OLIVE_APP_VERSION=0.1.0-staging
OLIVE_LOG_LEVEL=INFO
OLIVE_STAGING_PORT=8000
OLIVE_WEB_PORT=3000
OLIVE_COOKIE_SECURE=false
OLIVE_POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
OLIVE_SIGNAL_HMAC_KEY_ID=tradingview-staging
OLIVE_SIGNAL_HMAC_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
OLIVE_TRADINGVIEW_WEBHOOK_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
OLIVE_SIGNAL_MAX_AGE_SECONDS=300
OLIVE_SIGNAL_NONCE_TTL_SECONDS=900
OLIVE_PAPER_AUTO_EXECUTE=true
OLIVE_PAPER_EQUITY=100000
OLIVE_PAPER_AVAILABLE_MARGIN=50000
OLIVE_PAPER_REQUESTED_RISK_PCT=1
OLIVE_PAPER_FEE_RATE=0.001
OLIVE_ADMIN_API_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
OLIVE_ADMIN_API_ROLE=VIEWER
# Optional permanent Cloudflare named tunnel. Keep the token secret.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_NAMED_TUNNEL_TOKEN
OLIVE_TRADINGVIEW_PUBLIC_HOSTNAME=signals.example.com

